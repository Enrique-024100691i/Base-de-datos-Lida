use master
go
IF EXISTS (SELECT * FROM SYSDATABASES WHERE NAME ='DBAHORROS')
DROP DATABASE DBAHORROS
go
CREATE DATABASE DBAHORROS
---archivo primario
ON PRIMARY 
	(	NAME = DBAHORROS_dat,
		FILENAME = 'D:\DBAHORROS\Ahorros_dat.mdf',
		SIZE = 20,
		MAXSIZE = UNLIMITED,
		FILEGROWTH = 20MB )
		---archivo secundario
		LOG ON
	(	NAME = DBAHORROS_log,
		FILENAME = 'D:\DBAHORROS\Ahorros_log.ldf',
		SIZE = 20,
		MAXSIZE = UNLIMITED,
		FILEGROWTH = 20MB )
GO
