INSERT INTO TCliente (CodCliente, ApePaterno, ApeMaterno, Nombres, Cliente, CodUbigeo, FecNacimiento, Sexo, IndEstCivil, Nacionalidad, Direccion, Telefono, TipDocumento, NumDocIdentidad, ActEconomica, DenActEconomica, DirLaboral, NumTelLaboral, CodCurador, CodUsuario, FecRegistro, IndCliActivo)
