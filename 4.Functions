(
    @Tipo VARCHAR(1)
)
RETURNS INT
AS 
BEGIN
    DECLARE @Total INT;
--    SET @Total = (SELECT COUNT(*) FROM TCliente WHERE TipCliente = @Tipo);
    RETURN @Total;
END;
GO


-- ====================================================================
-- PRUEBAS DE EJECUCIÓN (Mostrando TODOS los datos del cliente + Edad)
-- ====================================================================

-- 1. Probar la edad con UN cliente específico y TODOS sus datos
SELECT 
    C.CodCliente AS 'Código Cliente',
    C.NumDocIdentidad AS 'N° Documento',
    C.ApePaterno AS 'Apellido Paterno',
    C.ApeMaterno AS 'Apellido Materno',
    C.Nombres AS 'Nombres',
    C.Direccion AS 'Dirección',
    C.Telefono AS 'Teléfono',
    C.CodUbigeo AS 'Código Ubigeo',
    C.FecNacimiento AS 'Fecha Nacimiento',
    dbo.fnCalcularEdadCliente(C.CodCliente) AS 'Edad'
FROM TCliente C
WHERE C.CodCliente = '1001425876';
GO

-- 2. Mostrar TODOS los datos de TODOS los clientes con su edad calculada
SELECT 
    C.CodCliente AS 'Código Cliente',
    C.NumDocIdentidad AS 'N° Documento',
    C.ApePaterno AS 'Apellido Paterno',
    C.ApeMaterno AS 'Apellido Materno',
    C.Nombres AS 'Nombres',
    C.Direccion AS 'Dirección',
    C.Telefono AS 'Teléfono',
    C.CodUbigeo AS 'Código Ubigeo',
    C.FecNacimiento AS 'Fecha Nacimiento',
    dbo.fnCalcularEdadCliente(C.CodCliente) AS 'Edad'
FROM TCliente C;
GO

-- 3. Contar total de clientes por tipo
SELECT dbo.fnNumeroClientesTipo('1') AS 'Total Clientes Tipo 1';
GO

USE DBAHORROS;
GO

-- ====================================================================
-- OBJETIVO        : Listar Agencia, Cliente y Edad
-- OBJETO          : fnListarAgenciaClienteEdad
-- TIPO            : Inline Table-Valued Function
-- DESCRIPCIÓN     : Función que extrae la agencia desde el código del
--                   cliente y calcula su edad actual.
-- FECHA CREACIÓN  : 14/09/2026
-- AUTOR           : PAOLO ENRIQUE ZAVALETA FUENTES
-- OBSERVACIONES   : Ninguna
-- ====================================================================
IF OBJECT_ID(N'dbo.fnListarAgenciaClienteEdad', N'IF') IS NOT NULL 
    DROP FUNCTION dbo.fnListarAgenciaClienteEdad;
GO 

CREATE FUNCTION dbo.fnListarAgenciaClienteEdad()
RETURNS TABLE
AS 
RETURN
(
    SELECT 
        -- Extrae la agencia del código de cliente (posiciones 2 y 3: ej. '03' de '003408012')
        SUBSTRING(CodCliente, 2, 2) AS Agencia,
        
        -- Nombre del cliente (o CodCliente según la estructura de tu tabla)
        CodCliente AS Cliente, 
        
        -- Cálculo de la edad actual
        (DATEDIFF(YEAR, FecNacimiento, GETDATE()) - 
            CASE 
                WHEN (MONTH(FecNacimiento) > MONTH(GETDATE())) 
                     OR (MONTH(FecNacimiento) = MONTH(GETDATE()) AND DAY(FecNacimiento) > DAY(GETDATE())) 
                THEN 1 
                ELSE 0 
            END) AS Edad
    FROM TCliente
);
GO

-- ====================================================================
-- EJEMPLO DE EJECUCIÓN:
-- ====================================================================
SELECT * FROM dbo.fnListarAgenciaClienteEdad();
GO
