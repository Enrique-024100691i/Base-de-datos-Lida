USE DBAHORROS;
GO

-- ====================================================================
-- 1. FUNCIÓN: Calcular Edad del Cliente Natural
-- ====================================================================
IF OBJECT_ID(N'dbo.fnCalcularEdadCliente', N'FN') IS NOT NULL 
    DROP FUNCTION dbo.fnCalcularEdadCliente;
GO 

CREATE FUNCTION dbo.fnCalcularEdadCliente
(
    @CodCliente VARCHAR(20)
)
RETURNS INT
AS 
BEGIN
    DECLARE @Edad INT;
    SET @Edad = (SELECT (YEAR(GETDATE()) - YEAR(FecNacimiento)) 
                 FROM TCliente 
                 WHERE CodCliente = @CodCliente);
    RETURN @Edad;
END;
GO


-- ====================================================================
-- 2. FUNCIÓN: Contar Clientes por Tipo
-- ====================================================================
IF OBJECT_ID(N'dbo.fnNumeroClientesTipo', N'FN') IS NOT NULL 
