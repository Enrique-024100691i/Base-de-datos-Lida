select * from TCuenta
IF OBJECT_ID ('trValidarCuenta', 'TR') IS NOT NULL
BEGIN
    DROP TRIGGER trValidarCuenta
END;
go
--========================================================================
--OBJETO        : trValidarCuenta
--TIPO          : Disparador
--DESCRIPCIÓN   : Valida las restricciones de la tabla cuenta
--                en la tabla cuenta
--FECHA DE CREACION : 25/09/2026
--AUTOR         : "CADA UNO PONE SU NOMBRE"
--OBSERVACIONES : Ninguna
--========================================================================
--PR            MODIFICADO    FECHA          DESCRIPCIÓN
--========================================================================
Create trigger trValidarCuenta
on TCuenta
After insert, update
as

-----validamos si el propietario de la cuenta es mayor o menor de edad
Declare @codcliente varchar(12)
Declare @codcurador varchar(12)
Declare @Edad int
Declare @NumCuenta varchar(10)
--obtener el codigo de cliente que se ha insertado en la tabla cuenta
set @codcliente=(select codcliente from inserted)
---obtener el codigo de curador del cliente se ha insertado
set @codcurador =(select codcurador from Tcliente where codcliente=@codcliente)
--obtener la cuenta que se ha insertado del cliente
set @NumCuenta=(select numcuenta from Tcuenta where codcliente=@codcliente)
---obtener la edad del cliente
set @Edad =(select year(Getdate())-year(FecNacimiento) from Tcliente where codcliente=@codcliente)
----validar la cuenta cuando es menor de edad
if @edad<18---es menor de edad y se debe preguntar si tiene curador
begin ---1
    if @codcurador is null ---el menor de edad no tiene curador
    begin--2
        print 'El cliente es menor de edad y no tiene curado, NO PUEDE APERTURAR CUENTA'
        --- si el dato no se cumple se elimina el registro insertado
        delete Tcuenta where CodCliente=@codcliente and NumCuenta=@NumCuenta
    end---fin de 2
    else
        print 'El cliente es menor de edad y tiene curador, SU CUENTA SE APERTURA CORRECTAMENTE'
end--fin de 1
else
    print 'El cliente es mayor de edad, SU CUENTA SE APERTURO CORRECTAMENTE'

