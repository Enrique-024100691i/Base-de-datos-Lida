	SELECT @NOMBRE='BkLog_ BDAHORROS -'+ @Fecha+'-'+ RTRIM(LTRIM(RIGHT('00'+SUBSTRING(LTRIM(RTRIM(CAST(CURRENT_TIMESTAMP AS VARCHAR))),13,2),2)+'_'+SUBSTRING(LTRIM(RTRIM(CAST(CURRENT_TIMESTAMP AS VARCHAR))),16,4)))
	SELECT @RUTA='D:\BACKUPS_LOG\'
	SELECT @DEST=  @RUTA +@NOMBRE+'.bak'
	
