/* ============================================================================
   2. PROCEDIMIENTO ALMACENADO: uspInsertarCuentasA006
   Inserta 1,000 cuentas A006 (250 por departamento)
   ============================================================================ */

CREATE PROCEDURE uspInsertarCuentasA006
AS
BEGIN
    SET NOCOUNT ON;
    
    DECLARE @DeptCodes TABLE (DeptCode CHAR(2), DeptName VARCHAR(50), TargetCount INT, CurrentCount INT);
    DECLARE @NumCuenta VARCHAR(10);
    DECLARE @CodCliente VARCHAR(12);
    DECLARE @Counter INT;
    DECLARE @DeptCode CHAR(2);
    DECLARE @CodTipAhorro VARCHAR(6);
    DECLARE @MonApertura NUMERIC(18,2);
    DECLARE @FecApertura DATETIME;
    DECLARE @PlzApertura INT;
    DECLARE @CodUsuario VARCHAR(10);
    DECLARE @SalCuenta NUMERIC(18,2);
    DECLARE @FecVencimiento DATETIME;
    DECLARE @IndCuenta VARCHAR(1);
    DECLARE @MaxSeq INT;
    
    -- Departamentos asignados al grupo A006
    INSERT INTO @DeptCodes VALUES 
        ('08', 'CUSCO', 250, 0),
        ('21', 'PUNO', 250, 0),
        ('04', 'AREQUIPA', 250, 0),
        ('03', 'APURIMAC', 250, 0);
    
    -- Configuración para A006 - Ahorro Kids
    SET @CodTipAhorro = 'A006';
    SET @PlzApertura = 12;           -- 12 meses según TTipAhorro
    SET @CodUsuario = 'AACURIO';     -- Usuario registrado en TipAhorro
    SET @FecApertura = GETDATE();
    SET @FecVencimiento = DATEADD(MONTH, 12, GETDATE());
    SET @IndCuenta = '1';            -- Cuenta activa
    
    -- Rangos de monto para A006
    DECLARE @MontMinimo NUMERIC(18,2) = 20;
    DECLARE @MontMaximo NUMERIC(18,2) = 500000;
    
    WHILE EXISTS (SELECT 1 FROM @DeptCodes WHERE CurrentCount < TargetCount)
    BEGIN
        SELECT TOP 1 @DeptCode = DeptCode 
        FROM @DeptCodes 
        WHERE CurrentCount < TargetCount
        ORDER BY DeptCode;
        
        IF @DeptCode IS NULL BREAK;
        
        SET @Counter = 0;
        
        WHILE @Counter < (SELECT TargetCount - CurrentCount FROM @DeptCodes WHERE DeptCode = @DeptCode)
        BEGIN
            -- Cliente aleatorio del departamento sin cuenta A006
            SELECT TOP 1 @CodCliente = C.CodCliente
            FROM TCliente C
            WHERE LEFT(C.CodUbigeo, 2) = @DeptCode
              AND C.IndCliActivo = '1'
              AND NOT EXISTS (
                  SELECT 1 FROM TCuenta TC 
                  WHERE TC.CodCliente = C.CodCliente 
                  AND TC.CodTipAhorro = 'A006'
              )
            ORDER BY NEWID();
            
            IF @CodCliente IS NULL BREAK;
            
            -- Generar NumCuenta: DeptCode(2) + Secuencial(8)
            SELECT @MaxSeq = ISNULL(MAX(CAST(SUBSTRING(NumCuenta, 3, 8) AS INT)), 0) 
            FROM TCuenta 
            WHERE SUBSTRING(NumCuenta, 1, 2) = @DeptCode;
            
            SET @NumCuenta = @DeptCode + RIGHT('00000000' + CAST(@MaxSeq + 1 AS VARCHAR(8)), 8);
            
            -- Monto aleatorio dentro del rango
            SET @MonApertura = ROUND(@MontMinimo + (RAND() * (@MontMaximo - @MontMinimo)), 2);
            SET @SalCuenta = @MonApertura;
            
            BEGIN TRY
                INSERT INTO TCuenta (
                    NumCuenta, CodTipAhorro, CodCliente, CodUsuario,
                    MonApertura, SalCuenta, MontInteresGanado,
                    PlzApertura, FecApertura, FecVencimiento, IndCuenta
                ) VALUES (
                    @NumCuenta, 'A006', @CodCliente, @CodUsuario,
                    @MonApertura, @SalCuenta, 0,
                    @PlzApertura, @FecApertura, @FecVencimiento, @IndCuenta
                );
                
                SET @Counter = @Counter + 1;
                UPDATE @DeptCodes SET CurrentCount = CurrentCount + 1 WHERE DeptCode = @DeptCode;
            END TRY
            BEGIN CATCH
                PRINT 'Error insertando para cliente ' + @CodCliente + ': ' + ERROR_MESSAGE();
            END CATCH
            
            IF @Counter > 300 BREAK;
        END
    END
    
    -- Resumen final
    SELECT DeptCode, DeptName, CurrentCount as Insertados, TargetCount as Objetivo
    FROM @DeptCodes;
    
    SELECT COUNT(*) as TotalCuentasA006 FROM TCuenta WHERE CodTipAhorro = 'A006';
END
GO

/* ============================================================================
   3. TRIGGER: trgValidarCuentaA006
   Valida reglas de negocio para cuentas A006 en INSERT/UPDATE
   ============================================================================ */

CREATE TRIGGER trgValidarCuentaA006
ON TCuenta
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    
    -- Validaciones específicas para A006 (Ahorro Kids)
    IF EXISTS (
        SELECT 1 FROM inserted i
        JOIN TTipAhorro ta ON i.CodTipAhorro = ta.CodTipAhorro
        WHERE i.CodTipAhorro = 'A006'
          AND (
              -- Monto apertura dentro de rango
              i.MonApertura < ta.MontMinimo 
              OR i.MonApertura > ta.MontMaximo
              -- Saldo no negativo
              OR i.SalCuenta < 0
              -- Plazo correcto (12 meses)
              OR i.PlzApertura <> ta.Plazo
              -- Moneda correcta (01 = Soles)
              OR ta.Moneda <> '01'
              -- Cliente existe y activo
              OR NOT EXISTS (SELECT 1 FROM TCliente c WHERE c.CodCliente = i.CodCliente AND c.IndCliActivo = '1')
              -- Usuario existe
              OR NOT EXISTS (SELECT 1 FROM TUsuario u WHERE u.CodUsuario = i.CodUsuario)
              -- Tipo ahorro existe y vigente
              OR NOT EXISTS (SELECT 1 FROM TTipAhorro t WHERE t.CodTipAhorro = i.CodTipAhorro AND t.IndVigente = '1')
              -- Formato NumCuenta: 10 chars, DeptCode válido
              OR LEN(i.NumCuenta) <> 10
              OR SUBSTRING(i.NumCuenta, 1, 2) NOT IN ('08','21','04','03')
              OR TRY_CAST(SUBSTRING(i.NumCuenta, 3, 8) AS INT) IS NULL
              -- Fecha apertura no futura
              OR i.FecApertura > GETDATE()
              -- Fecha vencimiento = apertura + plazo
              OR i.FecVencimiento <> DATEADD(MONTH, i.PlzApertura, i.FecApertura)
          )
    )
    BEGIN
        RAISERROR('Validación fallida: La cuenta A006 no cumple con las reglas de negocio.', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END
    
    -- Integridad referencial general
    IF EXISTS (
        SELECT 1 FROM inserted i
        WHERE NOT EXISTS (SELECT 1 FROM TCliente c WHERE c.CodCliente = i.CodCliente)
           OR NOT EXISTS (SELECT 1 FROM TUsuario u WHERE u.CodUsuario = i.CodUsuario)
           OR NOT EXISTS (SELECT 1 FROM TTipAhorro t WHERE t.CodTipAhorro = i.CodTipAhorro)
    )
    BEGIN
        RAISERROR('Error de integridad referencial: Cliente, Usuario o Tipo de Ahorro no existen.', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END
    
    -- Formato NumCuenta general
    IF EXISTS (
        SELECT 1 FROM inserted i
        WHERE LEN(i.NumCuenta) <> 10
    )
    BEGIN
        RAISERROR('NumCuenta debe tener exactamente 10 caracteres.', 16, 1);
        ROLLBACK TRANSACTION;
        RETURN;
    END
END
GO

/* ============================================================================
   4. VISTA: vwVerificarCuentasA006
   Consulta de verificación con todos los campos requeridos
   ============================================================================ */

CREATE VIEW vwVerificarCuentasA006
AS
SELECT 
    c.NumCuenta AS [Numero de Cuenta],
    ta.NomProducto AS [Nombre/Descripcion Cuenta],
    c.CodCliente AS [Codigo Cliente],
    cli.Cliente AS [Nombres y Apellidos Cliente],
    DATEDIFF(YEAR, cli.FecNacimiento, GETDATE()) - 
        CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, cli.FecNacimiento, GETDATE()), cli.FecNacimiento) > GETDATE() 
             THEN 1 ELSE 0 END AS [Edad Cliente],
    CASE 
        WHEN cli.CodCurador IS NOT NULL AND cli.CodCurador <> '' 
        THEN (SELECT TOP 1 Cliente FROM TCliente WHERE CodCliente = cli.CodCurador)
        ELSE 'Sin Curador'
    END AS [Curador],
    ta.NomProducto AS [Tipo de Cuenta],
    c.PlzApertura AS [Plazo],
    c.MonApertura AS [Monto de Apertura],
    c.SalCuenta AS [Saldo de la Cuenta],
    c.FecApertura AS [Fecha de Apertura],
    c.FecVencimiento AS [Fecha de Vencimiento],
    LEFT(cli.CodUbigeo, 2) AS [Cod. Departamento],
    (SELECT TOP 1 NOMBDEP FROM TUbigeo WHERE LEFT(CodUbigeo, 2) = LEFT(cli.CodUbigeo, 2)) AS [Departamento],
    c.CodUsuario AS [Usuario Registro],
    c.IndCuenta AS [Estado Cuenta]
FROM TCuenta c
JOIN TTipAhorro ta ON c.CodTipAhorro = ta.CodTipAhorro
JOIN TCliente cli ON c.CodCliente = cli.CodCliente
WHERE c.CodTipAhorro = 'A006'
GO

