IF OBJECT_ID('trg_TMovCuentaCliente_ActualizarSaldo', 'TR') IS NOT NULL
BEGIN
    DROP TRIGGER trg_TMovCuentaCliente_ActualizarSaldo;
END;
GO

-- 3. Creación del Trigger
CREATE TRIGGER trg_TMovCuentaCliente_ActualizarSaldo
ON TMovCuenta
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    -- TipMovimiento: '1' = Depósito (+), '2' = Retiro (-)
    UPDATE C
    SET C.SalCuenta = C.SalCuenta + CASE 
                                      WHEN I.TipMovimiento = '1' THEN I.MontMovimiento
                                      WHEN I.TipMovimiento = '2' THEN -I.MontMovimiento
                                      ELSE 0
                                   END
    FROM TCuenta C
    INNER JOIN inserted I ON C.NumCuenta = I.NumCuenta;
END;
GO

