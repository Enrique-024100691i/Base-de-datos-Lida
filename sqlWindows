--consulta que suma los movimiento que son de retiro
select sum(MontMovimiento) from TMovCuenta
where NumCuenta='C030000001'
and TipMovimiento=2

---actulizar el saldo de la cuenta
declare @depositos numeric (10,3)
declare @retiros numeric (10,3)
  set @depositos=Isnull((select sum(MontMovimiento)
                         from TMovCuenta where NumCuenta='C030000001'
                         and TipMovimiento=1),0)
select @depositos

  set @retiros=Isnull((select sum(MontMovimiento)
                       from TMovCuenta where NumCuenta='C030000001'
                       and TipMovimiento=2),0)
select @retiros

update TCuenta
set SalCuenta = MonApertura+@depositos-@retiros
where NumCuenta='C030000001'

